{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "contentful:seed": "node --env-file-if-exists=.env scripts/contentful/seed-homepage.mjs",
    "format:changed": "git status --porcelain | awk 'NF { print $2 }' | grep -E '\\.(astro|css|js|mjs|cjs|json|md|ts|tsx|html|yml|yaml)$' | xargs -r npx prettier --write --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,css,js,mjs,cjs,json,md,ts,tsx,html,yml,yaml}": "prettier --write --ignore-path .prettierignore"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@fontsource/poppins": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  }
}
