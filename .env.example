# Contentful (read at build time only; never exposed to the browser)
CONTENTFUL_SPACE_ID=wclkrpbrf32m
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API token (Settings > API keys in Contentful)
CONTENTFUL_DELIVERY_TOKEN=

# Only needed for `npm run contentful:seed` (Settings > CMA tokens). Do not add to Vercel.
CONTENTFUL_MANAGEMENT_TOKEN=
