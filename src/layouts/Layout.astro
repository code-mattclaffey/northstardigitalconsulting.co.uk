---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "../styles/global.css";
import "../styles/styles.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import { AVAILABILITY_WINDOW_DAYS, getAvailability } from "../lib/availability";
import { getHomepage } from "../lib/homepage";

interface Props {
  title?: string;
  description?: string;
  ogImageAlt?: string | null;
  /** Absolute canonical URL, for content first published elsewhere. */
  canonicalUrl?: string | null;
  /** Background of the first section, so the header text stays readable. */
  headerTone?: "dark" | "light";
}

const { title, description, ogImageAlt, canonicalUrl, headerTone = "dark" } = Astro.props;
const availability = getAvailability(await getHomepage());
---

<!doctype html>
<html
  lang="en-GB"
  class="dark"
  data-contract-end={availability.endDate}
  data-availability={availability.state}
>
  <head>
    <Head
      title={title}
      description={description}
      ogImageAlt={ogImageAlt}
      canonicalUrl={canonicalUrl}
    />
    <script is:inline define:vars={{ windowDays: AVAILABILITY_WINDOW_DAYS }}>
      const root = document.documentElement;
      root.classList.add("js");
      // Re-check the contract end date in the browser so the "available"
      // highlight switches on by itself, without waiting for a rebuild.
      const end = root.dataset.contractEnd;
      if (end) {
        const days = (new Date(end + "T00:00:00Z").getTime() - Date.now()) / 86400000;
        if (days <= 0) root.dataset.availability = "now";
        else if (days <= windowDays) root.dataset.availability = "soon";
        else delete root.dataset.availability;
      }
    </script>
  </head>
  <body class="relative">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-primary px-5 py-3 font-semibold text-primary-foreground focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
      >Skip to content</a
    >
    <Header tone={headerTone} />
    <Main>
      <slot />
    </Main>
    <Footer />
    <script>
      // Fade-up on scroll for [data-reveal] elements (styles in global.css).
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        items.forEach((item) => observer.observe(item));
      } else {
        items.forEach((item) => item.classList.add("is-revealed"));
      }
    </script>
  </body>
</html>
