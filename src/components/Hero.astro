---
import { ArrowRight } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import type { HomepageContent, PageSection } from "@/lib/homepage";
import ClientLogos from "./ClientLogos.astro";
import Container from "./Container.astro";
import Section from "./Section.astro";

interface Props {
  content: HomepageContent;
  section: PageSection;
}

const { content, section } = Astro.props;
const light = section.background === "light";
const external = (url: string) =>
  /^https?:\/\//.test(url) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<Section
  background={section.background}
  flush
  class="relative isolate overflow-hidden pt-[96px] pb-12 md:pb-18"
  aria-labelledby="hero-title"
>
  {
    light ? (
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_50%_105%,var(--color-brand-blue-200),transparent_70%),radial-gradient(40%_40%_at_90%_95%,rgb(124_108_240/0.25),transparent_70%)]"
        aria-hidden="true"
      />
    ) : (
      <>
        <div class="hero-glow hero-glow--indigo -z-10" aria-hidden="true" />
        <div class="hero-glow hero-glow--violet -z-10" aria-hidden="true" />
        <div class="hero-glow hero-glow--center -z-10" aria-hidden="true" />
      </>
    )
  }
  <Container class="flex flex-col items-center pt-6 text-center md:pt-18">
    {
      content.availabilityText && (
        <p
          class={badgeVariants({
            variant: "glass",
            class:
              "m-0 on-light:border-border on-light:bg-white on-light:text-foreground available:border-emerald-400/50",
          })}
        >
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute hidden size-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping available:inline-flex" />
            <span class="relative size-2 rounded-full bg-brand-blue-400 available:bg-emerald-400" />
          </span>
          {content.availabilityText}
        </p>
      )
    }
    <h1
      id="hero-title"
      class="mt-5 mb-0 max-w-[980px] text-[40px] md:mt-7 leading-[1.05] font-semibold tracking-[-0.03em] text-balance md:text-7xl"
    >
      {content.heroHeading}
    </h1>
    <p class="mt-4 mb-0 max-w-[720px] text-base md:mt-6 leading-relaxed text-brand-slate-300 on-light:text-muted-foreground md:text-xl">
      {content.heroBody}
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3 md:mt-9">
      <a
        href={content.primaryCtaUrl}
        class={buttonVariants({ size: "lg" })}
        {...external(content.primaryCtaUrl)}
      >
        {content.primaryCtaLabel}
        <ArrowRight aria-hidden="true" />
      </a>
      {
        content.secondaryCtaLabel && content.secondaryCtaUrl && (
          <a
            href={content.secondaryCtaUrl}
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class:
                "border-white/20 bg-brand-ink/40 font-medium hover:bg-white/10 on-light:border-border-strong on-light:bg-white on-light:hover:bg-muted",
            })}
            {...external(content.secondaryCtaUrl)}
          >
            {content.secondaryCtaLabel}
          </a>
        )
      }
    </div>

    <ClientLogos class="mt-10 md:mt-30" />
  </Container>
</Section>
