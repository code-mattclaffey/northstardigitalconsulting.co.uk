---
import ClientsCarousel from "./ClientsCarousel.astro";
import type { HomepageContent } from "../lib/homepage";

interface Props {
  content: HomepageContent;
}

const { content } = Astro.props;
const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<section class="c-hero" aria-labelledby="hero-title" class="text-center mt-60">
  <div class="c-hero__panel c-hero__panel--1" aria-hidden="true"></div>
  <div class="c-hero__panel c-hero__panel--2" aria-hidden="true"></div>
  <div class="c-hero__panel c-hero__panel--3" aria-hidden="true"></div>
  <div class="o-grid o-grid--indent">
    <div
      class="o-grid__item o-grid__item--span-2 o-grid__item--sm-4 o-grid__item--md-6 o-grid__item--lg-8 o-grid__item--xl-9"
    >
      <h1 class="e-heading e-heading--h1 mb-10" id="hero-title">
        {content.heroHeading}
      </h1>
      {
        content.heroSubheading && (
          <p class="e-heading e-heading--h3">{content.heroSubheading}</p>
        )
      }
      <p class="mb-12 e-body-text e-body-text--large max-w-[70ch]">
        {content.heroBody}
      </p>
      <div class="flex gap-4 mb-6">
        <a
          href={content.primaryCtaUrl}
          class="e-button e-button--primary"
          {...(isExternal(content.primaryCtaUrl) && {
            target: "_blank",
            rel: "noopener noreferrer",
          })}
        >
          {content.primaryCtaLabel}
        </a>
        {
          content.secondaryCtaLabel && content.secondaryCtaUrl && (
            <a
              href={content.secondaryCtaUrl}
              class="e-button e-button--secondary"
              {...(isExternal(content.secondaryCtaUrl) && {
                target: "_blank",
                rel: "noopener noreferrer",
              })}
            >
              {content.secondaryCtaLabel}
            </a>
          )
        }
      </div>
      {
        content.availabilityText && (
          <p class="inline-flex items-center e-body-text e-body-text--small font-semibold">
            <span class="c-hero__availability-dot w-4 h-4 mr-2 bg-orange-500 rounded-full" />
            {content.availabilityText}
          </p>
        )
      }
    </div>
  </div>

  <ClientsCarousel />
</section>
