---
import { ArrowRight } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import type { HomepageContent } from "@/lib/homepage";
import ClientLogos from "./ClientLogos.astro";
import Container from "./Container.astro";

interface Props {
  content: HomepageContent;
}

const { content } = Astro.props;
const external = (url: string) =>
  /^https?:\/\//.test(url) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<section class="bg-hero-glow overflow-hidden pt-[96px] pb-12 md:pb-18" aria-labelledby="hero-title">
  <Container class="flex flex-col items-center pt-12 text-center md:pt-18">
    {
      content.availabilityText && (
        <p class={badgeVariants({ variant: "glass", class: "m-0" })}>
          <span class="size-2 rounded-full bg-brand-blue-400" aria-hidden="true" />
          {content.availabilityText}
        </p>
      )
    }
    <h1
      id="hero-title"
      class="mt-7 mb-0 max-w-[980px] text-[40px] leading-[1.05] font-semibold tracking-[-0.03em] text-balance md:text-7xl"
    >
      {content.heroHeading}
    </h1>
    <p class="mt-6 mb-0 max-w-[720px] text-lg leading-relaxed text-brand-slate-300 md:text-xl">
      {content.heroBody}
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a
        href={content.primaryCtaUrl}
        class={buttonVariants({ size: "lg" })}
        {...external(content.primaryCtaUrl)}
      >
        {content.primaryCtaLabel}
        <ArrowRight aria-hidden="true" />
      </a>
      {
        content.secondaryCtaLabel && content.secondaryCtaUrl && (
          <a
            href={content.secondaryCtaUrl}
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-white/20 bg-brand-ink/40 font-medium hover:bg-white/10",
            })}
            {...external(content.secondaryCtaUrl)}
          >
            {content.secondaryCtaLabel}
          </a>
        )
      }
    </div>

    <ClientLogos class="mt-14 md:mt-30" />
  </Container>
</section>
