---
import { buttonVariants } from "@/components/ui/button";
import { CONTACT_MAILTO, NAV_LINKS } from "@/lib/site";
import Container from "./Container.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  !href.includes("#") && (path === href || path.startsWith(`${href}/`));
---

<header class="absolute inset-x-0 top-0 z-30 text-white">
  <Container class="flex items-center justify-between gap-6 py-6">
    <a href="/" class="flex rounded-md" aria-label="NorthStar Digital home">
      <Logo height={30} />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="text-[15px] font-medium text-brand-slate-200 no-underline transition-colors hover:text-white aria-[current=page]:font-semibold aria-[current=page]:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a href={CONTACT_MAILTO} class={buttonVariants()}>Get in touch</a>
    </nav>

    <details class="group md:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-xl border border-brand-ink-700 bg-brand-ink-900/70 [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <svg class="size-[22px] group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="hidden size-[22px] group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute inset-x-5 top-[84px] flex flex-col gap-1 rounded-2xl border border-brand-ink-700 bg-brand-ink-900 p-3 shadow-2xl"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class="rounded-lg p-3 font-medium text-white no-underline hover:bg-brand-ink-800"
            >
              {link.label}
            </a>
          ))
        }
        <a href={CONTACT_MAILTO} class={buttonVariants({ class: "mt-2 h-12" })}>
          Get in touch
        </a>
      </nav>
    </details>
  </Container>
</header>
