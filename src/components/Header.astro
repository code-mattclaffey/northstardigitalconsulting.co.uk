---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
interface Props {
  /** "light" when the page sits on the light c-page panel */
  theme?: "dark" | "light";
}
const { theme = "dark" } = Astro.props;
---

<header class="c-header">
  <div class="o-grid">
    <div
      class="o-grid__item o-grid__item--span-1 o-grid__item--md-3 o-grid__item--lg-6 o-grid__item--xl-6"
    >
      <a
        href="/"
        class="c-header__logo"
        aria-label="Northstar Digital Consulting Home"
        aria-current="page"
      >
        <Logo variant={theme === "light" ? "panel" : "light"} />
      </a>
    </div>
    <div
      class="o-grid__item o-grid__item--span-1 o-grid__item--md-3 o-grid__item--lg-6 o-grid__item--xl-6"
    >
      <nav class="c-header__nav hidden md:block" aria-label="Main navigation">
        <ul class="c-header__nav-list">
          <li class="c-header__nav-item">
            <a
              href="https://www.linkedin.com/company/130174180"
              target="_blank"
              rel="noopener noreferrer"
              class="c-header__nav-link c-header__nav-link--icon-link"
              aria-label="View my LinkedIn profile"
            >
              <span class="c-header__nav-icon">
                <Icon name="linkedIn" size="lg" />
              </span>
            </a>
          </li>
          <li class="c-header__nav-item">
            <a
              href="https://github.com/code-mattclaffey"
              target="_blank"
              rel="noopener noreferrer"
              class="c-header__nav-link c-header__nav-link--icon-link"
              aria-label="View my Github profile"
            >
              <span class="c-header__nav-icon">
                <Icon name="github" size="lg" />
              </span>
            </a>
          </li>
          <li class="c-header__nav-item">
            <a
              href="/blog?tag=case-study"
              class="e-button e-button--secondary c-header__nav-button"
              >Case studies</a
            >
          </li>
          <li class="c-header__nav-item">
            <a
              href="mailto:hello@northstardigitalconsulting.co.uk"
              class="e-button e-button--primary">Get in touch</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
