---
import { badgeVariants } from "@/components/ui/badge";

interface Props {
  eyebrow: string;
  id: string;
  align?: "center" | "start";
  class?: string;
}

const { eyebrow, id, align = "center", class: className } = Astro.props;
---

<div
  data-reveal
  class:list={[
    "flex flex-col",
    align === "center" ? "items-center text-center" : "items-start",
    className,
  ]}
>
  <span class={badgeVariants({ variant: "outline" })}>{eyebrow}</span>
  <h2
    id={id}
    class="mt-4 mb-0 max-w-[820px] md:mt-5 text-[32px] leading-[1.12] font-semibold tracking-[-0.02em] md:text-5xl"
  >
    <slot />
  </h2>
  {
    Astro.slots.has("lead") && (
      <p class="mt-4 mb-0 max-w-[720px] text-lg leading-relaxed text-muted-foreground">
        <slot name="lead" />
      </p>
    )
  }
</div>
