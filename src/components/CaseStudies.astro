---
import { ArrowUpRight } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { BLOG_TAG_LABELS, formatPublishDate, getBlogPosts } from "@/lib/blog";
import type { PageSection } from "@/lib/homepage";
import Container from "./Container.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

// Newest three posts tagged case-study. The section hides when there are none.
const featured = (await getBlogPosts())
  .filter((post) => post.tags.includes("case-study"))
  .slice(0, 3);
const art = ["bg-art-1", "bg-art-2", "bg-art-3"];

interface Props {
  section: PageSection;
}

const { section } = Astro.props;
---

{
  featured.length > 0 && (
    <Section
      background={section.background}
      id="case-studies"
      aria-labelledby="case-studies-title"
    >
      <Container>
        <SectionHeading eyebrow={section.eyebrow ?? "Case studies"} id="case-studies-title">
          {section.heading ?? "See what we’ve shipped together."}
          <Fragment slot="lead">
            {section.lead ?? "Real projects, the decisions behind them and what changed."}
          </Fragment>
        </SectionHeading>

        <ul class="swipe-row m-0 mt-12 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-3">
          {featured.map((post, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-border bg-card transition-colors hover:border-brand-blue-400/60">
                {post.heroImage ? (
                  <img
                    src={`${post.heroImage.url}?w=800&h=400&fit=fill&fm=webp`}
                    alt=""
                    width="800"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="h-[200px] w-full object-cover"
                  />
                ) : (
                  <div class:list={["h-[200px]", art[i % art.length]]} aria-hidden="true" />
                )}
                <div class="flex flex-1 flex-col gap-3 p-6">
                  <span class={badgeVariants()}>{BLOG_TAG_LABELS["case-study"]}</span>
                  <h3 class="m-0 text-xl leading-snug font-semibold">
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-foreground no-underline after:absolute after:inset-0 after:content-['']"
                    >
                      {post.title}
                    </a>
                  </h3>
                  <time class="text-[13px] text-muted-foreground" datetime={post.publishDate}>
                    {formatPublishDate(post.publishDate)}
                  </time>
                  <span
                    class="mt-auto flex items-center justify-between border-t border-secondary pt-4 text-sm font-medium"
                    aria-hidden="true"
                  >
                    Read case study
                    <ArrowUpRight className="size-[18px] text-primary" />
                  </span>
                </div>
              </article>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex justify-center">
          <a
            href="/blog?tag=case-study"
            class={buttonVariants({ variant: "outline", class: "h-12 px-6 font-medium" })}
          >
            All case studies
          </a>
        </div>
      </Container>
    </Section>
  )
}
