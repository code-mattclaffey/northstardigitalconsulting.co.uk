---
import BlogCard from "./BlogCard";
import { getBlogPosts, toSummary } from "../lib/blog";

// Build time only. Renders nothing when there are no posts.
const posts = (await getBlogPosts()).slice(0, 3).map(toSummary);
---

{
  posts.length > 0 && (
    <section class="c-latest-posts" aria-labelledby="latest-posts-title">
      <div class="o-grid o-grid--indent">
        <div class="o-grid__item o-grid__item--span-2 o-grid__item--sm-4 o-grid__item--md-6 o-grid__item--lg-12">
          <h2 class="e-heading e-heading--h2" id="latest-posts-title">
            Latest from the blog
          </h2>
          <ul class="c-blog-list__items">
            {posts.map((post) => (
              <li class="c-blog-list__item">
                <BlogCard post={post} headingLevel="h3" />
              </li>
            ))}
          </ul>
          <a href="/blog" class="e-button e-button--secondary">
            View all posts
          </a>
        </div>
      </div>
    </section>
  )
}
