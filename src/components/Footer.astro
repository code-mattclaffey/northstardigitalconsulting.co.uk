---
import {
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  AVAILABILITY_WINDOW_DAYS,
  CONTRACT_END,
  CV_URL,
  GITHUB_URL,
  LINKEDIN_URL,
  NAV_LINKS,
} from "@/lib/site";
import Container from "./Container.astro";
import CtaBand from "./CtaBand.astro";
import Logo from "./Logo.astro";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
const linkClass =
  "text-sm text-brand-slate-400 no-underline transition-colors hover:text-white";
---

<footer id="contact" class="dark bg-brand-ink pt-14 pb-10 md:pt-24 text-white">
  <Container>
    <CtaBand
      title="Let’s build something ambitious."
      body="Tell me about your challenge and I’ll reply within one working day."
      ctaLabel="Get in touch"
      ctaHref={CONTACT_MAILTO}
      availableFrom={CONTRACT_END}
      windowDays={AVAILABILITY_WINDOW_DAYS}
    />

    <div class="mt-18 grid grid-cols-1 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="flex flex-col gap-5">
        <Logo height={30} class="self-start" />
        <p class="m-0 max-w-[340px] text-sm leading-relaxed text-brand-slate-400">
          Principal-level engineering leadership for ambitious product teams. Based in
          Manchester, working UK-wide.
        </p>
        <ul class="m-0 flex list-none gap-2.5 p-0">
          <li>
            <a
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="NorthStar Digital on LinkedIn (opens in a new tab)"
              class="flex size-11 items-center justify-center rounded-xl bg-brand-ink-800 text-white transition-colors hover:bg-brand-ink-700"
            >
              <SocialIcon name="linkedin" class="size-5" />
            </a>
          </li>
          <li>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Matt Claffey on GitHub (opens in a new tab)"
              class="flex size-11 items-center justify-center rounded-xl bg-brand-ink-800 text-white transition-colors hover:bg-brand-ink-700"
            >
              <SocialIcon name="github" class="size-5" />
            </a>
          </li>
        </ul>
      </div>

      <nav aria-labelledby="footer-explore" class="flex flex-col gap-3">
        <h2 id="footer-explore" class="m-0 text-sm font-semibold">Explore</h2>
        {NAV_LINKS.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      </nav>

      <div class="flex flex-col gap-3">
        <h2 class="m-0 text-sm font-semibold">Contact</h2>
        <a href={CONTACT_MAILTO} class:list={[linkClass, "[overflow-wrap:anywhere]"]}>
          {CONTACT_EMAIL}
        </a>
        <span class="text-sm text-brand-slate-400">Manchester, UK</span>
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="m-0 text-sm font-semibold">Company</h2>
        <span class="text-sm text-brand-slate-400">NorthStar Digital Consulting Ltd</span>
        <a href={CV_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>CV</a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-wrap justify-between gap-3 border-t border-brand-ink-800 pt-6 text-[13px] text-brand-slate-400"
    >
      <span>&copy; {year} NorthStar Digital Consulting Ltd. All rights reserved.</span>
      <span>Registered in England and Wales</span>
    </div>
  </Container>
</footer>
